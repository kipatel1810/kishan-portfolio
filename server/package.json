{
  "name": "portfolio-api",
  "version": "1.0.0",
  "description": "REST API for Kishankumar Patel's portfolio",
  "main": "src/server.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/server.js",
    "dev": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env --watch src/server.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/",
    "test-email": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env scripts/verify-smtp.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "nodemailer": "^6.9.16",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.23.8"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13"
  }
}
